# Safe, non-secret deployment settings
APP_HOST=example.com
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
AUTH_METHODS=password
GOOGLE_WORKSPACE_DOMAINS=

# Secrets: set through the deployment environment; never commit values
DATABASE_URL=
QUEUE_DATABASE_URL=
SECRET_KEY_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
