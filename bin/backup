#!/usr/bin/env bash
set -euo pipefail

database_url="${DATABASE_URL:?DATABASE_URL is required}"
storage_root="${ACTIVE_STORAGE_ROOT:-storage}"
backup_root="${BACKUP_ROOT:-tmp/backups}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
final_dir="${backup_root%/}/${timestamp}"
staging_dir="${final_dir}.partial"

if [[ ! -d "$storage_root" ]]; then
  echo "Storage root does not exist: $storage_root" >&2
  exit 1
fi
if [[ -e "$final_dir" || -e "$staging_dir" ]]; then
  echo "Backup destination already exists: $final_dir" >&2
  exit 1
fi

mkdir -p "$backup_root" "$staging_dir"
trap 'rm -rf "$staging_dir"' EXIT

echo "==> Backing up PostgreSQL"
pg_dump --dbname "$database_url" --format custom --no-owner --file "$staging_dir/database.dump"

echo "==> Backing up local Active Storage"
tar --create --gzip --file "$staging_dir/storage.tar.gz" --directory "$storage_root" .

cat > "$staging_dir/manifest" <<EOF
FORMAT_VERSION=1
CREATED_AT=${timestamp}
DATABASE_ARCHIVE=database.dump
STORAGE_ARCHIVE=storage.tar.gz
EOF
(
  cd "$staging_dir"
  sha256sum database.dump storage.tar.gz > SHA256SUMS
)

mv "$staging_dir" "$final_dir"
trap - EXIT
echo "Backup complete: $final_dir"
