# Copy to .env before running Compose. Do not commit the resulting file.
POSTGRES_PASSWORD=replace-with-a-long-random-value
SECRET_KEY_BASE=replace-with-output-from-bin-rails-secret-at-least-64-characters
APP_HOST=localhost
PORT=3000
AUTH_METHODS=none
STORAGE_SERVICE=local
MAIL_DELIVERY_METHOD=none
FORCE_SSL=0

# Local S3 compatibility profile only; use real scoped credentials in production.
MINIO_ROOT_USER=rails-app-starter-kit-minio
MINIO_ROOT_PASSWORD=rails-app-starter-kit-minio-secret
